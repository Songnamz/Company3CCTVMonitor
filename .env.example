# Copy to .env and fill in. Never commit .env.

# Dahua XVR
XVR_HOST=192.168.1.20
# Use https + 443 if the XVR has "HTTPS" enabled (it then redirects HTTP CGI calls,
# showing up as "HTTP 302 from eventManager.cgi" in the logs).
XVR_SCHEME=http
XVR_HTTP_PORT=80
# Dahua uses a self-signed certificate; leave false unless you installed a trusted one.
XVR_VERIFY_TLS=false
XVR_RTSP_PORT=554
XVR_USER=viewer
# Letters and digits ONLY - the password is embedded in the RTSP URL used by go2rtc,
# so characters like @ : / # ? % & would break it.
XVR_PASS=changeme

# Channels to show/record (comma separated, 1-based)
CHANNELS=1,2,3,4

# Event codes to subscribe to (comma separated). Use "All" to debug what your
# firmware sends (every event is logged and captured - noisy!).
EVENT_CODES=FaceDetection

# Minimum seconds between two snapshots on the same channel
EVENT_COOLDOWN_SECONDS=3

# Delete events/snapshots older than this many days (0 = keep forever)
RETENTION_DAYS=30
# Also delete the oldest events while snapshots take more than this many GB (0 = no limit).
# Both are only defaults: values saved from the Settings tab override them.
RETENTION_MAX_GB=200

# Video clip around each event, copied from the XVR's recording (the XVR must be recording).
# An event at 21:10:10 gets 21:10:05-21:10:15. Clips are copied ~2 minutes after the event,
# once the XVR has written the footage to its disk.
CLIPS_ENABLED=true
CLIP_BEFORE_SECONDS=5
CLIP_AFTER_SECONDS=5

# DEBUG also logs heartbeats and full event payloads
LOG_LEVEL=INFO

# Password for the web UI login page (required - with no password nobody can log in).
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(16))"
# Changing it logs out every existing session.
APP_PASSWORD=
# Days a login stays valid
SESSION_DAYS=30

# --- AI person / no-shirt detection (detector container) ---
# Secret shared by the detector and the app. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
INTERNAL_TOKEN=
# Seconds between AI checks per camera
DETECT_INTERVAL_SECONDS=1
# Minimum YOLO confidence to count as a person (0-1)
PERSON_CONFIDENCE=0.3
# Minimum seconds between two "new person" events on one camera (no-shirt alerts ignore this)
PERSON_COOLDOWN_SECONDS=10
# Ignore people smaller than this many pixels tall (in the 1080p frame) - far away figures
PERSON_MIN_HEIGHT=120
# Only judge clothing on people at least this tall; smaller ones are too blurry
SHIRT_MIN_HEIGHT=150
# No-shirt probability (0-1) from the classifier trained on this site's cameras above which
# a person is flagged. Raise it (0.8) for fewer false alarms, lower it (0.5) to miss fewer.
SHIRTLESS_THRESHOLD=0.7
# CPU threads / cores the AI may use (this server has 4; 2 leaves headroom)
AI_THREADS=2
AI_CPUS=2
# Share (0-1) of a person's box that must be inside a camera's detection areas to count.
# Raise it (0.7) if people next to an area are still captured; lower it (0.3) if people
# at the edge of an area are missed.
ZONE_MIN_OVERLAP=0.5
